# Default: lightweight local unfolding; no Blender installation needed.
FOLDABLE_ENGINE=local
# Optional: set FOLDABLE_ENGINE=blender to use the vendored Blender engine.
# Backend geometry needs no API credentials. OpenAI is used by the frontend's AI route.
# Install bpy into the backend Python, OR set BLENDER_BIN to Blender 5.x.
# BLENDER_BIN=C:/Program Files/Blender Foundation/Blender 5.2/blender.exe
# BLENDER_PYTHON=/path/to/python-with-bpy
# FOLDABLE_STORAGE=/absolute/path/to/persistent/render-storage
